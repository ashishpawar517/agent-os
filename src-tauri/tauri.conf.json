{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Agent OS",
  "version": "0.1.0",
  "identifier": "com.agentos.app",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run src/main.ts",
    "beforeBuildCommand": "bun build",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Agent OS",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}